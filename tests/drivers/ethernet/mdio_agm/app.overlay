/*
 * Devicetree for the native MDIO suite.
 *
 * The binding nests the MDIO controller inside the MAC node and the driver
 * takes its register base from the *parent* (DT_REG_ADDR(DT_INST_PARENT)), so
 * the parent keeps the real MAC address 0x41040000 and the real four pinctrl
 * cells the MDIO pins need. mdio0 has no PHY child here: this suite tests the
 * bus, not the PHY.
 */

#include <zephyr/dt-bindings/pinctrl/agm-agrv2k-pinctrl.h>

/ {
	fake_intc: interrupt-controller {
		compatible = "vnd,fake-intc";
		interrupt-controller;
		#interrupt-cells = <2>;
	};

	agm_pinctrl: pinctrl {
		compatible = "agm,agrv2k-pinctrl";
		status = "okay";

		eth0_default: eth0_default {
			agm,pins = <AGM_PINCTRL(4, 0, AGM_PINCTRL_OUTPUT)>,
				   <AGM_PINCTRL(4, 0, AGM_PINCTRL_INPUT)>;
		};
	};

	eth_agm0: ethernet@41040000 {
		compatible = "agm,agrv2k-emac";
		reg = <0x41040000 0x28>;
		interrupts = <12 1>;
		interrupt-parent = <&fake_intc>;
		agm,ahb-clkenable-bit = <3>;
		agm,ahb-reset-bit = <3>;
		phy-connection-type = "rmii";
		/* Resolves the driver's phy-handle lookup to "no PHY device"
		 * (the node is disabled); this suite talks to the bus directly. */
		phy-handle = <&phy0>;
		local-mac-address = [02 00 5A 5A 00 02];
		pinctrl-0 = <&eth0_default>;
		pinctrl-names = "default";
		status = "okay";

		mdio0: mdio {
			compatible = "agm,agrv2k-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			phy0: ethernet-phy@1 {
				compatible = "microchip,lan8720";
				reg = <1>;
				status = "disabled";
			};
		};
	};
};
