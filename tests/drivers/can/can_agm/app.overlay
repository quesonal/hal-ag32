/* SPDX-License-Identifier: Apache-2.0 */
/*
 * Devicetree for the native CAN suite.
 *
 * The node keeps the *real* controller address (0x4002a000 = CAN0), the real
 * binding and the real pinctrl state shape (can0_default: GPIO8 bit 7 TX0
 * OUTPUT, GPIO7 bit 3 RX0 INPUT -- generated from the SDK's
 * PERIPHERAL_CAN_ENABLE route, see dts/riscv/agm/pinctrl-default.dtsi). The
 * register window itself is mapped to RAM by the shared fake-MMIO helper.
 *
 * The interrupt line is 29 (the SoC's PLIC CAN0 IRQ) because it is also inside
 * native_sim's 0..31 range: this suite actually pends it, unlike the other
 * suites where the `interrupts` property only satisfies the binding.
 *
 * bitrate = 125000 matches the agrv2k_407 board dts (the clock here is the
 * same 200 MHz the board's bitstream feeds the controller's XTAL1 input), so
 * the timing the driver computes is the one the hardware runs at.
 */

#include <zephyr/dt-bindings/pinctrl/agm-agrv2k-pinctrl.h>

/ {
	fake_intc: interrupt-controller {
		compatible = "vnd,fake-intc";
		interrupt-controller;
		#interrupt-cells = <2>;
	};

	fake_clk: clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
	};

	agm_pinctrl: pinctrl {
		compatible = "agm,agrv2k-pinctrl";
		status = "okay";

		can0_default: can0_default {
			agm,pins = <AGM_PINCTRL(8, 7, AGM_PINCTRL_OUTPUT)>,
				   <AGM_PINCTRL(7, 3, AGM_PINCTRL_INPUT)>;
		};
	};

	can_agm0: can@4002a000 {
		compatible = "agm,agrv2k-can";
		reg = <0x4002a000 0x1b4>;
		interrupts = <29 1>;
		interrupt-parent = <&fake_intc>;
		clocks = <&fake_clk>;
		agm,apb-clkenable-bit = <26>;	/* APB_MASK_CAN0 on the real part */
		pinctrl-0 = <&can0_default>;
		pinctrl-names = "default";
		bitrate = <125000>;
		status = "okay";
	};
};
