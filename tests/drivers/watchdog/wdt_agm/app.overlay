/*
 * Devicetree for the native SP805 watchdog suite: the real block address
 * (0x40011000), the real binding, the real APB gate bit, and an interrupt line
 * in native_sim's range (the SoC's is PLIC 4) so the driver's IRQ_CONNECT path
 * is compiled and its handler type is checked.
 */

/ {
	fake_intc: interrupt-controller {
		compatible = "vnd,fake-intc";
		interrupt-controller;
		#interrupt-cells = <2>;
	};

	fake_clk: clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000000>;
	};

	wdog_agm0: watchdog@40011000 {
		compatible = "agm,agrv2k-wdt";
		reg = <0x40011000 0x1000>;
		interrupts = <10 1>;
		interrupt-names = "wdt";
		interrupt-parent = <&fake_intc>;
		clocks = <&fake_clk>;
		agm,apb-clkenable-bit = <1>;
		status = "okay";
	};
};
