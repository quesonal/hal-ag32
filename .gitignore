# Local alias filename some tools look for; not part of the repository.
CLAUDE.md

# Local review scratchpads (workspace-only; conclusions go into docs/).
/code_review/

# Sample build outputs (west/cmake artifacts, ~30 MB each).
/samples/*/build/

# Stray in-tree build dirs (e.g. a mis-targeted `idf.py build` in the repo
# root). Same reasoning as the sample outputs above: never commit cmake
# caches or flash artifacts.
/build/

# Python bytecode from tools/ (create with `python3 -m py_compile`,
# `west build -t logic`, or any direct run of generate_board_ve.py).
__pycache__/

# Generated by tools/generate_board_ve.py from the agm,agrv2k-pins dts node
# (Option 2 migration: the generator output lives next to the board .dts,
# not under the pre-migration /zephyr/boards/... path).
/boards/agm/agrv2k*/board.ve
# ... and its sibling: the ASF fragment carrying the electrical
# attributes the pin map asks for (agm,pull-ups / agm,pull-downs).
# build_bitstream.sh feeds it to pre_logic.tcl, which folds it into
# logic/board.asf.
/boards/agm/agrv2k*/board.generated.asf

# Generated by board_common.cmake configure_file from
# boards/agm/agrv2k/shared/support/openocd.cfg.in (configure-time artifact;
# per-board FLASH_SIZE / BITSTREAM_ADDR substituted by cmake @ONLY).
# LEGACY (previously): the cfg is generated into <build>/logic/ now --
# kept so a stale checkout cannot commit one.
/boards/agm/agrv2k*/support/openocd.cfg

# Generated by tools/build_bitstream.sh + af_quartus.tcl into a
# Quartus-ready logic/ directory (each `west build -t logic` rerun
# overwrites; check logic/ back into git only if you need to ship a
# pre-built bitstream without rerunning Quartus).
/boards/agm/agrv2k*/logic/

# Vendor documents (AG32 MCU reference manual, VE/logic configuration
# notes, pinout tables, SN65HVD230 datasheet, ...) are controlled
# material and are NOT redistributed with this module. Keep local copies
# in a directory of your own and use
# this path only as a drop-in for cross-checking, so it never comes back
# into the repository.
/docs/datasheet/

# Documents that describe development process rather than the module:
# probe/USB flake histories, porting pitfall lists, add-on plans. Kept
# locally for maintainers; not part of the published tree.
/dev-notes/

# Local copies of the 200 MHz reference image and the .ve it was built from.
# They are *not* redistributed with the module -- samples/bitstreams/README.md
# tells the reader to keep their own copy -- so keep them out of the index.
/samples/bitstreams/example_board.bin
/samples/bitstreams/example_board.ve
